# Variable names only. Real values live in untracked files (chmod 600), never in git.

# --- secrets.env (mounted read-only into auth + shortcut) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
AUTH_START_TOKEN=
SHORTCUT_TOKEN=

# --- db.env (TimescaleDB) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- consumer.env (consumer + shortcut) ---
DATABASE_URL=

# --- .env next to docker-compose.yml (Compose variable interpolation) ---
TESLA_VIN=
KAFKA_CLUSTER_ID=
LOCAL_TZ=

# --- scripts ---
TELEMETRY_HOSTNAME=

# --- optional path overrides (scripts default to /opt/tesla/...) ---
TESLA_HOME=
SECRETS_FILE=
TOKENS_FILE=
API_LOG=
TELEMETRY_DIR=
TESLA_CLI=
TESLA_REFRESH_CMD=
