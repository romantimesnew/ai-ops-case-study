{
  "host": "0.0.0.0",
  "port": 8443,
  "status_port": 8080,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "tesla",
  "transmit_decoded_records": true,
  "reliable_ack_sources": { "V": "kafka" },
  "monitoring": { "prometheus_metrics_port": 9090 },
  "logger": { "verbose": false },
  "rate_limit": { "enabled": true, "message_interval_time": 30, "message_limit": 1000 },
  "kafka": {
    "bootstrap.servers": "kafka:9092",
    "queue.buffering.max.messages": 100000,
    "acks": "all"
  },
  "records": {
    "V": ["kafka"],
    "alerts": ["kafka"],
    "errors": ["kafka"],
    "connectivity": ["kafka"]
  },
  "tls": {
    "server_cert": "/certs/tls.crt",
    "server_key": "/certs/tls.key"
  }
}
